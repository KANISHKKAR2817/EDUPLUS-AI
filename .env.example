# EduPulse AI - Environment Configuration Example
PROJECT_NAME="EduPulse AI"
API_V1_STR="/api"

# Security Secrets (Generate a secure random key in production)
SECRET_KEY="edupulse-hackathon-super-secret-key-2026-secure-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default persistent SQLite for hackathon)
DATABASE_URL="sqlite:///./edupulse.db"

# Google Gemini API Key
# If omitted or invalid, EduPulse automatically switches to its high-quality deterministic educational tutor fallback!
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Uploads directory
UPLOAD_DIR="./uploads"

# Configurable Risk Component Weights (Sum = 1.0)
WEIGHT_ATTENDANCE=0.25
WEIGHT_ASSESSMENT=0.35
WEIGHT_ASSIGNMENT=0.20
WEIGHT_TREND=0.20

# Risk Display Bands
BAND_LOW_MAX=29.0
BAND_MODERATE_MAX=59.0
BAND_HIGH_MAX=79.0
